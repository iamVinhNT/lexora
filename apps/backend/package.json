{
  "name": "@lexora/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "verify:runtime": "pnpm run build && node scripts/runtime-smoke.mjs"
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./shared-database": {
      "types": "./dist/db/shared-database.d.ts",
      "import": "./dist/db/shared-database.js"
    },
    "./db/shared-database": {
      "types": "./dist/db/shared-database.d.ts",
      "import": "./dist/db/shared-database.js"
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.5.13",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
