{
  "name": "lexora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"pnpm --filter @lexora/backend dev\" \"pnpm --filter @lexora/frontend dev\"",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
