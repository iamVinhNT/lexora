{
  "name": "lexora",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"pnpm --filter @lexora/backend dev\" \"pnpm --filter @lexora/frontend dev\"",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:changed": "node scripts/test-changed.mjs",
    "verify": "pnpm run typecheck && pnpm test",
    "desktop:dev": "pnpm --filter @lexora/backend build && pnpm --filter @lexora/frontend build && pnpm --filter @lexora/desktop dev",
    "desktop:local": "pnpm run desktop:dev",
    "desktop:build": "pnpm --filter @lexora/backend build && pnpm --filter @lexora/frontend build && pnpm --filter @lexora/desktop build",
    "desktop:dist": "pnpm run desktop:build && pnpm --filter @lexora/desktop dist:linux",
    "desktop:smoke": "node apps/desktop/scripts/artifact-smoke.mjs",
    "desktop:packaged-smoke": "pnpm --filter @lexora/desktop packaged-smoke",
    "desktop:acceptance": "pnpm run desktop:dist && pnpm --filter @lexora/desktop acceptance"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
